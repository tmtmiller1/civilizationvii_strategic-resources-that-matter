<?xml version="1.0" encoding="utf-8"?>
<!--
  Strategic Resources That Matter, a Civilization VII mod.
  A unit that draws on a strategic resource its owner holds none of fights weaker and trains slower; past six copies
  the count keeps adding strength. The data does the penalties and the curve; ui/sr-recheck.js makes the engine
  notice a lost resource; ui/sr-unit-panel.js says on the unit panel when a unit is unsupplied;
  ui/sr-production-line.js says on a gated unit's production item what it needs; ui/sr-production-lock.js keeps a
  unit the hard gate locks in the production and purchase lists, greyed, with the reason; ui/sr-resource-line.js says in a
  strategic resource's description which units it supplies; ui/sr-supply-lost.js raises a notification when the
  local player loses the last copy of a resource its units need; ui/sr-callout.js shows a tutorial callout the first
  time the player selects an unsupplied unit.
  The Civilopedia rows load in the game scope, as the base game's do (base-standard loads its civilopedia data in
  base-game-main); their text is in the same text files as everything else.
  Groups: the setup options and text at the main menu; the unit tags, the Civilopedia page, the notification type
  and its icon, and the scripts in every game; per age, which units draw on which resource; per age and setup value,
  the penalty (Light, Standard, Harsh; none for Off) with its line on each gated unit's Civilopedia page, and the
  curve; per age, for the two locked levels of Unsupplied Units (Locked: training; Locked: training and upgrade),
  the harsh penalty plus the Units.StrategicResource column on every gated unit with the engine's own minimum
  parameters and the gate's line on each gated unit's Civilopedia page, plus the grant-only lines
  (sr-<age>-gate-lines.sql) that keep a free unit trainable until its owner could train the gated unit it upgrades
  into, with a civilization's own copy of the Warrior or the Frigate where its unique stands in for the next unit
  (its icon and look in sr-line-icons.xml and sr-line-visuals.xml); the same gate files under the Gated Units value
  a save from before 1.2 carries. With Modern Supply Chains on, sr-modern-chains.sql gives every Modern unit a second
  resource (its tags, its page lines, and under the locked levels its grant-only lock behind both). With Free
  Tier-Up by Kills off, sr-kill-tiers-off.sql takes out the kill-count tier-up of any unit whose tier needs a
  resource while upgrades are gated, so the ordinary upgrade (and its resource check) is the only way up.
  AffectsSavedGames is 1: the setup options and modifiers are fixed when a game is created, so a save made with the
  mod needs it to load the same game.
-->
<Mod id="tower-strategic-resources-that-matter" version="1" xmlns="ModInfo">
    <Properties>
        <Name>LOC_SR_MOD_NAME</Name>
        <Description>LOC_SR_MOD_DESCRIPTION</Description>
        <Authors>Tower</Authors>
        <Package>StrategicResourcesThatMatter</Package>
        <PackageSortIndex>100</PackageSortIndex>
        <Version>1.2.0</Version>
        <AffectsSavedGames>1</AffectsSavedGames>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always"><AlwaysMet></AlwaysMet></Criteria>
        <Criteria id="antiquity"><AgeInUse>AGE_ANTIQUITY</AgeInUse></Criteria>
        <Criteria id="exploration"><AgeInUse>AGE_EXPLORATION</AgeInUse></Criteria>
        <Criteria id="modern"><AgeInUse>AGE_MODERN</AgeInUse></Criteria>
