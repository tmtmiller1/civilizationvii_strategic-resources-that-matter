    <ActionGroups>
        <ActionGroup id="strategic-resources-that-matter-shell" scope="shell" criteria="always">
            <Actions>
                <UpdateDatabase><Item>data/sr-setup.sql</Item></UpdateDatabase>
                <!-- The looks of the gate's unit copies, in the shell too so Options can list them, as the game's own are. -->
                <UpdateVisualRemaps><Item>data/sr-line-visuals.xml</Item></UpdateVisualRemaps>
                <UpdateText>
                    <Item>text/en_us/StrategicResourcesThatMatterText.xml</Item>
                    <Item locale="de_DE">text/de_de/StrategicResourcesThatMatterText.xml</Item>
                    <Item locale="es_ES">text/es_es/StrategicResourcesThatMatterText.xml</Item>
                    <Item locale="fr_FR">text/fr_fr/StrategicResourcesThatMatterText.xml</Item>
                    <Item locale="it_IT">text/it_it/StrategicResourcesThatMatterText.xml</Item>
                    <Item locale="ja_JP">text/ja_jp/StrategicResourcesThatMatterText.xml</Item>
                    <Item locale="ko_KR">text/ko_kr/StrategicResourcesThatMatterText.xml</Item>
                    <Item locale="pl_PL">text/pl_pl/StrategicResourcesThatMatterText.xml</Item>
                    <Item locale="pt_BR">text/pt_br/StrategicResourcesThatMatterText.xml</Item>
                    <Item locale="ru_RU">text/ru_ru/StrategicResourcesThatMatterText.xml</Item>
                    <Item locale="zh_Hans_CN">text/zh_cn/StrategicResourcesThatMatterText.xml</Item>
                    <Item locale="zh_Hant_HK">text/zh_hk/StrategicResourcesThatMatterText.xml</Item>
                </UpdateText>
                <UIScripts>
                    <!-- Tower Settings Keeper: listed first, imports nothing, so it runs before anything reads storage. -->
                    <Item>ui/settings-keeper.js</Item>
                    <!-- Keeps the mod's visual remaps out of the Options list. -->
                    <Item>ui/sr-line-look.js</Item>
                </UIScripts>
                <ImportFiles>
                    <Item>ui/sr-line-look.js</Item>
                    <Item>ui/sr-log.js</Item>
                </ImportFiles>
            </Actions>
        </ActionGroup>
        <ActionGroup id="strategic-resources-that-matter-game" scope="game" criteria="always">
            <Properties><LoadOrder>200</LoadOrder></Properties>
            <Actions>
                <UpdateDatabase>
