<?xml version="1.0" encoding="utf-8"?>
<!-- Dev only. Ends Antiquity and Exploration after 10 age-progress points (about 10 turns) in a new game, so both age
     transitions can be watched with this mod's units on the map. Age progress is fixed when a game starts. Remove it
     from Mods/ afterward: it shortens every game it loads into. Never shipped. -->
<Mod id="tower-sr-short-age-probe" version="1" xmlns="ModInfo">
	<Properties>
		<Name>Strategic Resources That Matter short age probe (dev)</Name>
		<Description>Dev only: Antiquity and Exploration end after 10 points.</Description>
		<Authors>Tower</Authors>
		<Package>StrategicResourcesThatMatter</Package>
		<ShowInBrowser>1</ShowInBrowser>
		<AffectsSavedGames>1</AffectsSavedGames>
	</Properties>
	<ActionCriteria>
		<Criteria id="always"><AlwaysMet></AlwaysMet></Criteria>
	</ActionCriteria>
	<ActionGroups>
		<ActionGroup id="sr-short-age-data" scope="game" criteria="always">
			<Actions>
				<UpdateDatabase><Item>data/short-age.xml</Item></UpdateDatabase>
			</Actions>
			<Properties><LoadOrder>10002</LoadOrder></Properties>
		</ActionGroup>
	</ActionGroups>
</Mod>
