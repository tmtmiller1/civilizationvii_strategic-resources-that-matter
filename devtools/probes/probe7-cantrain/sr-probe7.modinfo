<?xml version="1.0" encoding="utf-8"?>
<!-- Dev only, never shipped. Does a civilization's unique with CanTrain 0 (its own trait kept) stop the engine making
     the unit before it obsolete, does the mod's grant (the civilization's trait and the resource) make it trainable,
     and does the upgrade then go to the unique? The Legion, over the gate's line file. Remove it from Mods/ after. -->
<Mod id="tower-sr-probe7" version="1" xmlns="ModInfo">
	<Properties>
		<Name>SR probe 7: CanTrain (dev)</Name>
		<Description>Dev only.</Description>
		<Authors>Tower</Authors>
		<Package>StrategicResourcesThatMatter</Package>
		<ShowInBrowser>1</ShowInBrowser>
		<AffectsSavedGames>1</AffectsSavedGames>
	</Properties>
	<ActionCriteria>
		<Criteria id="antiquity"><AgeInUse>AGE_ANTIQUITY</AgeInUse></Criteria>
	</ActionCriteria>
	<ActionGroups>
		<ActionGroup id="sr-probe7-data" scope="game" criteria="antiquity">
			<Actions><UpdateDatabase><Item>data/probe7.sql</Item></UpdateDatabase></Actions>
			<Properties><LoadOrder>10003</LoadOrder></Properties>
		</ActionGroup>
	</ActionGroups>
</Mod>
