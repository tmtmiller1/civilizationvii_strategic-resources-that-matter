<?xml version="1.0" encoding="utf-8"?>
<!-- Dev only, never shipped. What the engine does with a civilization's copy of the Warrior when the game's own
     rewards name UNIT_WARRIOR: a grant to the capital (the story shape 3282B), a production bonus (3293C), and a
     unit requirement "is a Warrior" in a one-requirement TEST_ALL set (250C) against the same in a TEST_ANY set
     that also names the copy (the gate's widening). Loads after the gate's line file. Remove after the run. -->
<Mod id="tower-sr-probe9" version="1" xmlns="ModInfo">
	<Properties>
		<Name>SR probe 9: grants (dev)</Name>
		<Description>Dev only.</Description>
		<Authors>Tower</Authors>
		<Package>StrategicResourcesThatMatter</Package>
		<ShowInBrowser>1</ShowInBrowser>
		<AffectsSavedGames>1</AffectsSavedGames>
	</Properties>
	<ActionCriteria>
		<Criteria id="antiquity"><AgeInUse>AGE_ANTIQUITY</AgeInUse></Criteria>
	</ActionCriteria>
	<ActionGroups>
		<ActionGroup id="sr-probe9-data" scope="game" criteria="antiquity">
			<Actions>
				<UpdateDatabase>
					<Item>data/probe9-modifiers.xml</Item>
					<Item>data/probe9.sql</Item>
				</UpdateDatabase>
			</Actions>
			<Properties><LoadOrder>10003</LoadOrder></Properties>
		</ActionGroup>
	</ActionGroups>
</Mod>
