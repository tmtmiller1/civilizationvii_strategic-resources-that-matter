<?xml version="1.0" encoding="utf-8"?>
<!-- Dev only, never shipped. The Warrior grant and the Warrior production bonus (the story shapes 3282B and
     3293C) attached to a major player behind "holds Iron", which the mod's turn-start re-check evaluates, so both
     land after the capital exists: does the grant give Rome its copy, and does the bonus reach the copy's cost?
     Loads after the gate's line file. Remove after the run. -->
<Mod id="tower-sr-probe9b" version="1" xmlns="ModInfo">
	<Properties>
		<Name>SR probe 9b: grants behind Iron (dev)</Name>
		<Description>Dev only.</Description>
		<Authors>Tower</Authors>
		<Package>StrategicResourcesThatMatter</Package>
		<ShowInBrowser>1</ShowInBrowser>
		<AffectsSavedGames>1</AffectsSavedGames>
	</Properties>
	<ActionCriteria>
		<Criteria id="antiquity"><AgeInUse>AGE_ANTIQUITY</AgeInUse></Criteria>
	</ActionCriteria>
	<ActionGroups>
		<ActionGroup id="sr-probe9b-data" scope="game" criteria="antiquity">
			<Actions>
				<UpdateDatabase>
					<Item>data/probe9b-modifiers.xml</Item>
					<Item>data/probe9b.sql</Item>
				</UpdateDatabase>
			</Actions>
			<Properties><LoadOrder>10003</LoadOrder></Properties>
		</ActionGroup>
	</ActionGroups>
</Mod>
