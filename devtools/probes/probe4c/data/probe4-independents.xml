<?xml version="1.0" encoding="utf-8"?>
<!-- probe4c: every non-major player gets the locked units back, in the shape that works for majors: attach per
     player over all players, the grant on the child behind "not a major player". -->
<GameEffects xmlns="GameEffects">
    <Modifier id="SRP4_ATTACH_MINOR_GRANTS" collection="COLLECTION_ALL_PLAYERS" effect="EFFECT_ATTACH_MODIFIERS">
        <Argument name="ModifierId">SRP4_GRANT_MINOR_WARRIOR</Argument>
    </Modifier>
    <Modifier id="SRP4_GRANT_MINOR_WARRIOR" collection="COLLECTION_OWNER" effect="EFFECT_ADJUST_PLAYER_VALID_UNIT_BUILD">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_PLAYER_IS_MAJOR" inverse="true"/>
        </SubjectRequirements>
        <Argument name="UnitType">UNIT_WARRIOR</Argument>
    </Modifier>
    <Modifier id="SRP4_ATTACH_MINOR_GRANTS_2" collection="COLLECTION_ALL_PLAYERS" effect="EFFECT_ATTACH_MODIFIERS">
        <Argument name="ModifierId">SRP4_GRANT_MINOR_SPEARMAN</Argument>
    </Modifier>
    <Modifier id="SRP4_GRANT_MINOR_SPEARMAN" collection="COLLECTION_OWNER" effect="EFFECT_ADJUST_PLAYER_VALID_UNIT_BUILD">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_PLAYER_IS_MAJOR" inverse="true"/>
        </SubjectRequirements>
        <Argument name="UnitType">UNIT_SPEARMAN</Argument>
    </Modifier>
</GameEffects>
