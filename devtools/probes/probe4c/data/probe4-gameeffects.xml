        </SubjectRequirements>
        <Argument name="UnitType">UNIT_SPEARMAN</Argument>
    </Modifier>
    <Modifier id="SRP4_ATTACH_GRANT_CHARIOT" collection="COLLECTION_MAJOR_PLAYERS" effect="EFFECT_ATTACH_MODIFIERS">
