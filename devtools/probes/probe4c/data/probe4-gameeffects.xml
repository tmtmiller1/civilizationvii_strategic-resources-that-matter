            <Requirement type="REQUIREMENT_PLAYER_HAS_X_RESOURCE_TYPE">
                <Argument name="ResourceType">RESOURCE_IRON</Argument>
                <Argument name="Amount">1</Argument>
            </Requirement>
            <Requirement type="REQUIREMENT_PLAYER_HAS_CIVILIZATION_OR_LEADER_TRAIT" inverse="true">
                <Argument name="TraitType">TRAIT_GAUL</Argument>
            </Requirement>
            <Requirement type="REQUIREMENT_PLAYER_HAS_CIVILIZATION_OR_LEADER_TRAIT" inverse="true">
