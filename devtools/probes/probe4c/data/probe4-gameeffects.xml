        </SubjectRequirements>
        <Argument name="UnitType">UNIT_CHARIOT</Argument>
    </Modifier>
    <Modifier id="SRP4_ATTACH_GRANT_LEGION" collection="COLLECTION_MAJOR_PLAYERS" effect="EFFECT_ATTACH_MODIFIERS">
