<?xml version="1.0" encoding="utf-8"?>
<!-- Throwaway probe for the hard gate (DESIGN.md section 7f). Dev only, never ship.
     Antiquity: the Warrior, Spearman and Legion locked in place by TraitType (the Foederati's trait, which only
     minor civilizations carry), the Chariot locked by CanTrain 0; one grant per unit behind has-resource (the Legion's
     also behind the Rome trait). Modern: the Field Cannon locked the same way, granted behind has-Niter.
     data/probe4-strategic.sql is not listed: probe4b adds it (Units.StrategicResource on the Spearman as well). -->
<Mod id="sr-probe4c" version="1" xmlns="ModInfo">
    <Properties>
        <Name>Strategic Resources That Matter Probe 4c (dev)</Name>
        <Description>Dev only: in-place training locks and grants.</Description>
        <Authors>Tower</Authors>
        <Package>SRProbe4c</Package>
        <PackageSortIndex>9996</PackageSortIndex>
        <Version>0.0.1</Version>
        <AffectsSavedGames>0</AffectsSavedGames>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
    </Dependencies>
    <ActionCriteria>
        <Criteria id="antiquity"><AgeInUse>AGE_ANTIQUITY</AgeInUse></Criteria>
        <Criteria id="modern"><AgeInUse>AGE_MODERN</AgeInUse></Criteria>
    </ActionCriteria>
    <ActionGroups>
        <ActionGroup id="sr-probe4c-antiquity" scope="game" criteria="antiquity">
            <Properties><LoadOrder>9000</LoadOrder></Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/probe4.sql</Item>
                    <Item>data/probe4-strategic.sql</Item>
                    <Item>data/probe4-independents.xml</Item>
                    <Item>data/probe4-gameeffects.xml</Item>
                    <Item>data/probe4.xml</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
        <ActionGroup id="sr-probe4c-modern" scope="game" criteria="modern">
            <Properties><LoadOrder>9000</LoadOrder></Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/probe4-modern.sql</Item>
                    <Item>data/probe4-modern-gameeffects.xml</Item>
                    <Item>data/probe4-modern.xml</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
    </ActionGroups>
</Mod>
