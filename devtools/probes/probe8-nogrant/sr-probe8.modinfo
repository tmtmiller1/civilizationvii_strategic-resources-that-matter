<?xml version="1.0" encoding="utf-8"?>
<!-- Dev only, never shipped. Rome's Legion back as the game has it (its trait, trainable, no grant) over the gate's
     line file, the Spearman's lock left on: does Rome's Warrior then upgrade into the Legion, with Iron and without?
     Tells the Legion's grant from the Spearman's lock as the cause of the upgrade into a Spearman. Remove after. -->
<Mod id="tower-sr-probe8" version="1" xmlns="ModInfo">
	<Properties>
		<Name>SR probe 8: no grant (dev)</Name>
		<Description>Dev only.</Description>
		<Authors>Tower</Authors>
		<Package>StrategicResourcesThatMatter</Package>
		<ShowInBrowser>1</ShowInBrowser>
		<AffectsSavedGames>1</AffectsSavedGames>
	</Properties>
	<ActionCriteria>
		<Criteria id="antiquity"><AgeInUse>AGE_ANTIQUITY</AgeInUse></Criteria>
	</ActionCriteria>
	<ActionGroups>
		<ActionGroup id="sr-probe8-data" scope="game" criteria="antiquity">
			<Actions><UpdateDatabase><Item>data/probe8.sql</Item></UpdateDatabase></Actions>
			<Properties><LoadOrder>10003</LoadOrder></Properties>
		</ActionGroup>
	</ActionGroups>
</Mod>
