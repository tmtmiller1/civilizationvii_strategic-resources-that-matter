<?xml version="1.0" encoding="utf-8"?>
<Database>
    <LocalizedText>
        <Replace Tag="LOC_SR_MOD_NAME" Language="zh_Hant_HK"><Text>至關重要的戰略資源</Text></Replace>
        <Replace Tag="LOC_SR_MOD_DESCRIPTION" Language="zh_Hant_HK"><Text>戰略資源再次變得重要。需要馬、鐵、硝石、石油、煤或橡膠的單位，在其擁有者一份該資源都沒有時，戰鬥力降低、訓練變慢；每份資源仍提供遊戲原有的加成。失去最後一份後，懲罰會在一回合後恢復。超過六份後，數量仍會繼續增加戰鬥力。兩項遊戲設定選項決定懲罰程度並開關後期加成。僅限單人遊戲。在多人遊戲中，失去資源後，要等該玩家獲得某種資源時懲罰才會恢復。</Text></Replace>
        <Replace Tag="LOC_SR_UNSUPPLIED_LINE" Language="zh_Hant_HK"><Text>無補給：沒有{1_Resource}（戰鬥力{2_Combat}，訓練變慢）</Text></Replace>
        <Replace Tag="LOC_SR_PRODUCTION_NEEDS_NONE" Language="zh_Hant_HK"><Text>需要{1_Resource}。沒有時：戰鬥力{2_Combat}，訓練變慢。</Text></Replace>
        <Replace Tag="LOC_SR_PRODUCTION_NEEDS_HELD" Language="zh_Hant_HK"><Text>需要{1_Resource}（擁有{2_Copies}個）。</Text></Replace>
        <Replace Tag="LOC_SR_PRODUCTION_NEEDS_NONE_SHORT" Language="zh_Hant_HK"><Text>需要{1_Resource}</Text></Replace>
        <Replace Tag="LOC_SR_PRODUCTION_NEEDS_HELD_SHORT" Language="zh_Hant_HK"><Text>{1_Resource}：{2_Copies}個</Text></Replace>
        <Replace Tag="LOC_SR_RESOURCE_SUPPLIES" Language="zh_Hant_HK"><Text>補給單位：{1_Units}。</Text></Replace>
        <Replace Tag="LOC_SR_RESOURCE_SUPPLIES_MORE" Language="zh_Hant_HK"><Text>補給單位：{1_Units}等，另有{2_More}種。</Text></Replace>
        <Replace Tag="LOC_SR_LIST_PAIR" Language="zh_Hant_HK"><Text>{1_First}、{2_Second}</Text></Replace>
        <Replace Tag="LOC_SR_PREVIEW_UNSUPPLIED" Language="zh_Hant_HK"><Text>{2_Combat} 無補給：沒有{3_Resource}</Text></Replace>
        <Replace Tag="LOC_SR_PREVIEW_CURVE" Language="zh_Hant_HK"><Text>+{2_Combat} {4_Resource}：{3_Copies}份或以上</Text></Replace>
        <Replace Tag="LOC_SR_SETUP_UNSUPPLIED_NAME" Language="zh_Hant_HK"><Text>無補給單位</Text></Replace>
        <Replace Tag="LOC_SR_SETUP_UNSUPPLIED_DESCRIPTION" Language="zh_Hant_HK"><Text>當擁有者一份所需的戰略資源都沒有時，單位會變弱多少、訓練會慢多少。</Text></Replace>
        <Replace Tag="LOC_SR_SETUP_UNSUPPLIED_OFF" Language="zh_Hant_HK"><Text>關閉</Text></Replace>
        <Replace Tag="LOC_SR_SETUP_UNSUPPLIED_OFF_DESCRIPTION" Language="zh_Hant_HK"><Text>沒有懲罰。每份資源仍提供遊戲原有的加成。</Text></Replace>
        <Replace Tag="LOC_SR_SETUP_UNSUPPLIED_LIGHT" Language="zh_Hant_HK"><Text>輕微</Text></Replace>
        <Replace Tag="LOC_SR_SETUP_UNSUPPLIED_LIGHT_DESCRIPTION" Language="zh_Hant_HK"><Text>戰鬥力-2，用於該單位的生產力減少20%。</Text></Replace>
        <Replace Tag="LOC_SR_SETUP_UNSUPPLIED_STANDARD" Language="zh_Hant_HK"><Text>標準</Text></Replace>
        <Replace Tag="LOC_SR_SETUP_UNSUPPLIED_STANDARD_DESCRIPTION" Language="zh_Hant_HK"><Text>戰鬥力-3，用於該單位的生產力減少33%（訓練時間延長一半）。</Text></Replace>
        <Replace Tag="LOC_SR_SETUP_UNSUPPLIED_HARSH" Language="zh_Hant_HK"><Text>嚴酷</Text></Replace>
        <Replace Tag="LOC_SR_SETUP_UNSUPPLIED_HARSH_DESCRIPTION" Language="zh_Hant_HK"><Text>戰鬥力-5，用於該單位的生產力減少50%（訓練時間加倍）。</Text></Replace>
        <Replace Tag="LOC_SR_SETUP_LATE_CURVE_NAME" Language="zh_Hant_HK"><Text>超過六份的戰略資源</Text></Replace>
        <Replace Tag="LOC_SR_SETUP_LATE_CURVE_DESCRIPTION" Language="zh_Hant_HK"><Text>遊戲原有的每份戰略資源+1戰鬥力的加成在六份時停止。開啟此選項後，單位在擁有8、10、12、14、16、18和20份時各再獲得+1。</Text></Replace>
        <Replace Tag="LOC_SR_SETUP_LATE_CURVE_OFF" Language="zh_Hant_HK"><Text>關閉</Text></Replace>
        <Replace Tag="LOC_SR_SETUP_LATE_CURVE_OFF_DESCRIPTION" Language="zh_Hant_HK"><Text>加成在六份時停止，與基礎遊戲相同。</Text></Replace>
        <Replace Tag="LOC_SR_SETUP_LATE_CURVE_ON" Language="zh_Hant_HK"><Text>開啟</Text></Replace>
        <Replace Tag="LOC_SR_SETUP_LATE_CURVE_ON_DESCRIPTION" Language="zh_Hant_HK"><Text>在8、10、12、14、16、18和20份時戰鬥力+1。</Text></Replace>
        <!-- Civilopedia -->
        <Replace Tag="LOC_PEDIA_CONCEPTS_PAGE_SR_STRATEGIC_RESOURCES_TITLE" Language="zh_Hant_HK"><Text>重要的戰略資源</Text></Replace>
        <Replace Tag="LOC_PEDIA_CONCEPTS_PAGE_SR_STRATEGIC_RESOURCES_CHAPTER_CONTENT_PARA_1" Language="zh_Hant_HK"><Text>需要{LOC_RESOURCE_HORSES_NAME}、{LOC_RESOURCE_IRON_NAME}、{LOC_RESOURCE_NITER_NAME}、{LOC_RESOURCE_OIL_NAME}、{LOC_RESOURCE_COAL_NAME}或{LOC_RESOURCE_RUBBER_NAME}的軍事單位，在其擁有者沒有該資源時，戰鬥更弱，訓練更慢。沒有任何東西被禁止：所有單位仍可像基礎遊戲中一樣訓練和升級。</Text></Replace>
        <Replace Tag="LOC_PEDIA_CONCEPTS_PAGE_SR_STRATEGIC_RESOURCES_CHAPTER_UNSUPPLIED_TITLE" Language="zh_Hant_HK"><Text>沒有資源時</Text></Replace>
        <Replace Tag="LOC_PEDIA_CONCEPTS_PAGE_SR_STRATEGIC_RESOURCES_CHAPTER_UNSUPPLIED_PARA_1" Language="zh_Hant_HK"><Text>缺少資源的單位，其擁有的每項戰鬥力（近戰，以及遠程和轟炸，如果有的話）都會降低，所在城市投入訓練它的生產力也會減少。降低多少由遊戲設定中的{LOC_SR_SETUP_UNSUPPLIED_NAME}選項決定：</Text></Replace>
        <Replace Tag="LOC_PEDIA_CONCEPTS_PAGE_SR_STRATEGIC_RESOURCES_CHAPTER_UNSUPPLIED_PARA_2" Language="zh_Hant_HK"><Text>[B]{LOC_SR_SETUP_UNSUPPLIED_LIGHT}：[/B]戰鬥力-2，生產力減少20%。[N][B]{LOC_SR_SETUP_UNSUPPLIED_STANDARD}[/B]（預設）：戰鬥力-3，生產力減少33%，訓練時間變為1.5倍。[N][B]{LOC_SR_SETUP_UNSUPPLIED_HARSH}：[/B]戰鬥力-5，生產力減少50%，訓練時間加倍。[N][B]{LOC_SR_SETUP_UNSUPPLIED_OFF}：[/B]無懲罰。</Text></Replace>
        <Replace Tag="LOC_PEDIA_CONCEPTS_PAGE_SR_STRATEGIC_RESOURCES_CHAPTER_UNSUPPLIED_PARA_3" Language="zh_Hant_HK"><Text>戰鬥預覽會把懲罰單獨列為一行，例如「-3 無補給：沒有{LOC_RESOURCE_NITER_NAME}」，單位面板也會在屬性下方註明。</Text></Replace>
        <Replace Tag="LOC_PEDIA_CONCEPTS_PAGE_SR_STRATEGIC_RESOURCES_CHAPTER_COPY_TITLE" Language="zh_Hant_HK"><Text>甚麼算一份資源</Text></Replace>
        <Replace Tag="LOC_PEDIA_CONCEPTS_PAGE_SR_STRATEGIC_RESOURCES_CHAPTER_COPY_PARA_1" Language="zh_Hant_HK"><Text>你擁有的地圖上的戰略資源算一份：位於你的格子上並帶有該資源的改良設施（城市擴張到該格子時建造的那種），或透過貿易路線從其他文明的定居點進口，從路線到達的回合起計算。</Text></Replace>
        <Replace Tag="LOC_PEDIA_CONCEPTS_PAGE_SR_STRATEGIC_RESOURCES_CHAPTER_COPY_PARA_2" Language="zh_Hant_HK"><Text>在地圖之外給予、背後沒有格子的資源不計算在內。</Text></Replace>
        <Replace Tag="LOC_PEDIA_CONCEPTS_PAGE_SR_STRATEGIC_RESOURCES_CHAPTER_LOSS_TITLE" Language="zh_Hant_HK"><Text>失去資源</Text></Replace>
        <Replace Tag="LOC_PEDIA_CONCEPTS_PAGE_SR_STRATEGIC_RESOURCES_CHAPTER_LOSS_PARA_1" Language="zh_Hant_HK"><Text>新的一份資源一到就會解除懲罰。因掠奪、格子易主或任何其他原因失去一份資源，懲罰會在一回合後恢復，對你和AI玩家都一樣。</Text></Replace>
        <Replace Tag="LOC_PEDIA_CONCEPTS_PAGE_SR_STRATEGIC_RESOURCES_CHAPTER_LOSS_PARA_2" Language="zh_Hant_HK"><Text>與貿易夥伴開戰會終止路線：路線帶來的資源立即消失，保護也隨之消失。只要玩家至少擁有一份資源，其單位就沒有懲罰。</Text></Replace>
        <Replace Tag="LOC_PEDIA_CONCEPTS_PAGE_SR_STRATEGIC_RESOURCES_CHAPTER_PAST_SIX_TITLE" Language="zh_Hant_HK"><Text>超過六份</Text></Replace>
        <Replace Tag="LOC_PEDIA_CONCEPTS_PAGE_SR_STRATEGIC_RESOURCES_CHAPTER_PAST_SIX_PARA_1" Language="zh_Hant_HK"><Text>遊戲每份資源給予戰鬥力+1，最多六份。開啟{LOC_SR_SETUP_LATE_CURVE_NAME}選項（預設）時，更多資源會繼續增加：在8、10、12、14、16、18和20份時戰鬥力+1，作用於遊戲每份資源加成所涵蓋的單位。戰鬥預覽會在遊戲自身那一行旁邊以一行顯示，例如「+1 {LOC_RESOURCE_NITER_NAME}：8份或以上」。</Text></Replace>
        <Replace Tag="LOC_PEDIA_CONCEPTS_PAGE_SR_STRATEGIC_RESOURCES_CHAPTER_GATES_TITLE" Language="zh_Hant_HK"><Text>哪些單位需要甚麼</Text></Replace>
        <Replace Tag="LOC_PEDIA_CONCEPTS_PAGE_SR_STRATEGIC_RESOURCES_CHAPTER_GATES_PARA_1" Language="zh_Hant_HK"><Text>文明的特色單位需要其所取代的單位所需的資源。</Text></Replace>
        <Replace Tag="LOC_PEDIA_CONCEPTS_PAGE_SR_STRATEGIC_RESOURCES_CHAPTER_GATES_PARA_2" Language="zh_Hant_HK"><Text>[B]{LOC_AGE_ANTIQUITY_NAME}[/B][N]{LOC_RESOURCE_HORSES_NAME}：騎兵（馬戰車, 騎手及其特色版本）[N]{LOC_RESOURCE_IRON_NAME}：第二級起的步兵（槍兵, 方陣, 羅馬軍團, 長生軍等）</Text></Replace>
        <Replace Tag="LOC_PEDIA_CONCEPTS_PAGE_SR_STRATEGIC_RESOURCES_CHAPTER_GATES_PARA_3" Language="zh_Hant_HK"><Text>[B]{LOC_AGE_EXPLORATION_NAME}[/B][N]{LOC_RESOURCE_HORSES_NAME}：騎兵（追獵者, 騎士, 槍騎兵及其特色版本）[N]{LOC_RESOURCE_IRON_NAME}：第二級起的步兵（披甲戰士, 長矛兵及其特色版本）[N]{LOC_RESOURCE_NITER_NAME}：攻城單位（投石機, 拋石機, 射石砲, 火車）和第二級起的重型戰艦（克拉克帆船, 蓋倫帆船及其特色版本）</Text></Replace>
        <Replace Tag="LOC_PEDIA_CONCEPTS_PAGE_SR_STRATEGIC_RESOURCES_CHAPTER_GATES_PARA_4" Language="zh_Hant_HK"><Text>[B]{LOC_AGE_MODERN_NAME}[/B][N]{LOC_RESOURCE_NITER_NAME}：炮兵（野戰加農砲, 野戰砲, 反坦克砲, 迫擊砲, 榴彈砲, 突擊砲）[N]{LOC_RESOURCE_OIL_NAME}：裝甲部隊（陸地戰艦, 戰車及其特色版本）和戰列艦（無畏戰艦, 戰艦及其特色版本）[N]{LOC_RESOURCE_COAL_NAME}：輕型戰艦（裝甲艦, 巡洋艦, 驅逐艦, 巴巴里海盜）[N]{LOC_RESOURCE_RUBBER_NAME}：飛機</Text></Replace>
        <Replace Tag="LOC_PEDIA_CONCEPTS_PAGE_SR_STRATEGIC_RESOURCES_CHAPTER_GATES_PARA_5" Language="zh_Hant_HK"><Text>不受任何要求限制：戰士系列和偵察兵、遠程步兵（弓箭手, 弩手, 鉤銃手）、柯克船和風帆戰列艦、胸甲騎兵、潛水艇以及近代步兵，因此每位玩家都始終能夠防禦。</Text></Replace>
        <Replace Tag="LOC_SR_PEDIA_TERM_UNSUPPLIED" Language="zh_Hant_HK"><Text>無補給</Text></Replace>
        <Replace Tag="LOC_SR_PEDIA_TERM_STRATEGIC" Language="zh_Hant_HK"><Text>戰略資源</Text></Replace>
        <Replace Tag="LOC_SR_PEDIA_UNIT_CHAPTER" Language="zh_Hant_HK"><Text>戰略資源</Text></Replace>
        <Replace Tag="LOC_SR_PEDIA_UNIT_HORSES_LIGHT" Language="zh_Hant_HK"><Text>需要{LOC_RESOURCE_HORSES_NAME}：沒有時戰鬥力-2，訓練變慢。</Text></Replace>
        <Replace Tag="LOC_SR_PEDIA_UNIT_HORSES_STANDARD" Language="zh_Hant_HK"><Text>需要{LOC_RESOURCE_HORSES_NAME}：沒有時戰鬥力-3，訓練變慢。</Text></Replace>
        <Replace Tag="LOC_SR_PEDIA_UNIT_HORSES_HARSH" Language="zh_Hant_HK"><Text>需要{LOC_RESOURCE_HORSES_NAME}：沒有時戰鬥力-5，訓練變慢。</Text></Replace>
        <Replace Tag="LOC_SR_PEDIA_UNIT_IRON_LIGHT" Language="zh_Hant_HK"><Text>需要{LOC_RESOURCE_IRON_NAME}：沒有時戰鬥力-2，訓練變慢。</Text></Replace>
        <Replace Tag="LOC_SR_PEDIA_UNIT_IRON_STANDARD" Language="zh_Hant_HK"><Text>需要{LOC_RESOURCE_IRON_NAME}：沒有時戰鬥力-3，訓練變慢。</Text></Replace>
        <Replace Tag="LOC_SR_PEDIA_UNIT_IRON_HARSH" Language="zh_Hant_HK"><Text>需要{LOC_RESOURCE_IRON_NAME}：沒有時戰鬥力-5，訓練變慢。</Text></Replace>
        <Replace Tag="LOC_SR_PEDIA_UNIT_NITER_LIGHT" Language="zh_Hant_HK"><Text>需要{LOC_RESOURCE_NITER_NAME}：沒有時戰鬥力-2，訓練變慢。</Text></Replace>
        <Replace Tag="LOC_SR_PEDIA_UNIT_NITER_STANDARD" Language="zh_Hant_HK"><Text>需要{LOC_RESOURCE_NITER_NAME}：沒有時戰鬥力-3，訓練變慢。</Text></Replace>
        <Replace Tag="LOC_SR_PEDIA_UNIT_NITER_HARSH" Language="zh_Hant_HK"><Text>需要{LOC_RESOURCE_NITER_NAME}：沒有時戰鬥力-5，訓練變慢。</Text></Replace>
        <Replace Tag="LOC_SR_PEDIA_UNIT_OIL_LIGHT" Language="zh_Hant_HK"><Text>需要{LOC_RESOURCE_OIL_NAME}：沒有時戰鬥力-2，訓練變慢。</Text></Replace>
        <Replace Tag="LOC_SR_PEDIA_UNIT_OIL_STANDARD" Language="zh_Hant_HK"><Text>需要{LOC_RESOURCE_OIL_NAME}：沒有時戰鬥力-3，訓練變慢。</Text></Replace>
        <Replace Tag="LOC_SR_PEDIA_UNIT_OIL_HARSH" Language="zh_Hant_HK"><Text>需要{LOC_RESOURCE_OIL_NAME}：沒有時戰鬥力-5，訓練變慢。</Text></Replace>
        <Replace Tag="LOC_SR_PEDIA_UNIT_COAL_LIGHT" Language="zh_Hant_HK"><Text>需要{LOC_RESOURCE_COAL_NAME}：沒有時戰鬥力-2，訓練變慢。</Text></Replace>
        <Replace Tag="LOC_SR_PEDIA_UNIT_COAL_STANDARD" Language="zh_Hant_HK"><Text>需要{LOC_RESOURCE_COAL_NAME}：沒有時戰鬥力-3，訓練變慢。</Text></Replace>
        <Replace Tag="LOC_SR_PEDIA_UNIT_COAL_HARSH" Language="zh_Hant_HK"><Text>需要{LOC_RESOURCE_COAL_NAME}：沒有時戰鬥力-5，訓練變慢。</Text></Replace>
        <Replace Tag="LOC_SR_PEDIA_UNIT_RUBBER_LIGHT" Language="zh_Hant_HK"><Text>需要{LOC_RESOURCE_RUBBER_NAME}：沒有時戰鬥力-2，訓練變慢。</Text></Replace>
        <Replace Tag="LOC_SR_PEDIA_UNIT_RUBBER_STANDARD" Language="zh_Hant_HK"><Text>需要{LOC_RESOURCE_RUBBER_NAME}：沒有時戰鬥力-3，訓練變慢。</Text></Replace>
        <Replace Tag="LOC_SR_PEDIA_UNIT_RUBBER_HARSH" Language="zh_Hant_HK"><Text>需要{LOC_RESOURCE_RUBBER_NAME}：沒有時戰鬥力-5，訓練變慢。</Text></Replace>
        <!-- /Civilopedia -->
        <!-- Lost-supply notification and first-time callout -->
        <Replace Tag="LOC_SR_NOTIFY_LOST_TITLE" Language="zh_Hant_HK"><Text>補給喪失</Text></Replace>
        <Replace Tag="LOC_SR_NOTIFY_LOST_MESSAGE" Language="zh_Hant_HK"><Text>補給喪失：{1_Resources}</Text></Replace>
        <Replace Tag="LOC_SR_NOTIFY_LOST_FALLBACK" Language="zh_Hant_HK"><Text>你的單位所需的一種戰略資源沒有了。在重新獲得之前，它們戰鬥力降低，訓練變慢。</Text></Replace>
        <Replace Tag="LOC_SR_NOTIFY_LOST_NONE" Language="zh_Hant_HK"><Text>補給喪失：沒有{1_Resource}。在重新獲得{1_Resource}之前，需要它的單位戰鬥力{2_Combat}，訓練變慢。</Text></Replace>
        <Replace Tag="LOC_SR_NOTIFY_LOST_ONE" Language="zh_Hant_HK"><Text>補給喪失：沒有{1_Resource}。在重新獲得{1_Resource}之前，你的{2_Unit}戰鬥力{3_Combat}，訓練變慢。</Text></Replace>
        <Replace Tag="LOC_SR_NOTIFY_LOST_MANY" Language="zh_Hant_HK"><Text>補給喪失：沒有{1_Resource}。在重新獲得{1_Resource}之前，你的{2_Unit}和其他{3_Others}個單位戰鬥力{4_Combat}，訓練變慢。</Text></Replace>
    </LocalizedText>
</Database>
